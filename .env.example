# --- Docker image (GHCR) ---
# Готовый образ собирается GitHub Actions при push в main и публикуется в ghcr.io.
# По умолчанию используется ghcr.io/cardio-assistant/landing:latest.
IMAGE=ghcr.io/cardio-assistant/landing:latest

# Если пакет в GHCR приватный, нужны креды (см. DEPLOY.md):
# 1) GitHub -> Settings -> Developer settings -> Personal access tokens (classic)
# 2) Scope: read:packages
# Если пакет публичный, оставьте GHCR_USER/GHCR_TOKEN пустыми.
GHCR_USER=
GHCR_TOKEN=

# --- Reverse tunnel (frp): app.ai-cardio.ru -> рабочая система на ПК ---
# Общий секрет между frps (этот VPS) и frpc (ПК). Один и тот же с обеих
# сторон. Сгенерировать: openssl rand -hex 32
FRP_TOKEN=replace_with_long_random_token

# --- Заявки формы обратной связи: только e-mail ---
# Российский почтовый сервис, без трансграничной передачи (152-ФЗ; так написано
# в Политике и в согласии формы). Иностранные каналы не подключать.
# deploy.sh читает .env как bash: значения с символами $ ` ! и пробелами — в одинарных кавычках.
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_USER=support@ai-cardio.ru
SMTP_PASS='replace_with_mailbox_password'
SMTP_FROM=support@ai-cardio.ru
SMTP_TO=support@ai-cardio.ru
SMTP_TIMEOUT_MS=15000
