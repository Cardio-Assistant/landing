# --- Docker image (GHCR) ---
# Готовый образ собирается GitHub Actions при push в main и публикуется в ghcr.io.
# По умолчанию используется ghcr.io/cardio-assistant/landing:latest.
IMAGE=ghcr.io/cardio-assistant/landing:latest

# Если пакет в GHCR приватный, нужны креды (см. DEPLOY.md):
# 1) GitHub -> Settings -> Developer settings -> Personal access tokens (classic)
# 2) Scope: read:packages
# Если пакет публичный, оставьте GHCR_USER/GHCR_TOKEN пустыми.
GHCR_USER=
GHCR_TOKEN=

# --- Telegram notifications ---
# Создайте бота через @BotFather, добавьте его в нужный чат и укажите chat_id.
TELEGRAM_BOT_TOKEN=1234567890:replace_with_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Опционально: ID топика, если отправка идет в тему супергруппы/форума.
TELEGRAM_THREAD_ID=

# Опционально: базовый URL Telegram API, если на сервере нужен прокси.
# TELEGRAM_API_BASE=https://api.telegram.org

# Опционально: HTTP/HTTPS proxy для исходящих запросов к Telegram API.
# Формат: http://user:password@host:port или http://host:port
TELEGRAM_PROXY_URL=
