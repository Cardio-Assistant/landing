# --- Docker image (GHCR) ---
# Готовый образ собирается GitHub Actions при push в main и публикуется в ghcr.io.
# По умолчанию используется ghcr.io/cardio-assistant/landing:latest.
IMAGE=ghcr.io/cardio-assistant/landing:latest

# Если пакет в GHCR приватный — нужны креды (см. DEPLOY.md):
# 1) GitHub → Settings → Developer settings → Personal access tokens (classic)
# 2) Scope: read:packages
# Если пакет публичный — оставь GHCR_USER/GHCR_TOKEN пустыми.
GHCR_USER=
GHCR_TOKEN=

# --- SMTP (Yandex) ---
# Создай пароль приложения: https://id.yandex.ru/security → "Пароли приложений" → "Почта"
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=alexosipov03@yandex.com
SMTP_PASS=замени_на_пароль_приложения_яндекса
SMTP_FROM=alexosipov03@yandex.com
SMTP_TO=alexosipov03@yandex.com
