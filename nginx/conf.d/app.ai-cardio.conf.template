# Рабочая система Cardio Assistant (непубличный адрес): app.ai-cardio.ru/web -> туннель frp -> ПК web:3001.
# На VPS копируется в nginx/conf.d/app.ai-cardio.conf (сертификат выпускается отдельно, см. DEPLOY.md).
# Публичный ai-cardio.ru/web — демо на примерах (app.conf.template).
server {
    listen 80;
    listen [::]:80;
    server_name app.ai-cardio.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name app.ai-cardio.ru;

    ssl_certificate     /etc/letsencrypt/live/app.ai-cardio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.ai-cardio.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # Не индексировать рабочую систему
    add_header X-Robots-Tag "noindex, nofollow" always;

    access_log /var/log/nginx/app.access.log;
    error_log  /var/log/nginx/app.error.log;

    location = /robots.txt { add_header Content-Type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
    location = / { return 302 /web/auth; }
    location = /web { return 302 /web/; }

    location /web/ {
        resolver 127.0.0.11 valid=30s;
        set $frps_upstream frps:7001;
        proxy_pass http://$frps_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        client_max_body_size 512m;
        proxy_connect_timeout 5s;
        proxy_read_timeout  300s;
        proxy_send_timeout  300s;
        proxy_buffering off;
        # ПК или туннель недоступны (nginx сам не смог соединиться/дождаться) — заставка.
        # proxy_intercept_errors не включаем: ответы 502/503 самого приложения (JSON) проходят как есть.
        error_page 502 504 =503 /__app_unavailable.html;
    }
    location = /__app_unavailable.html {
        internal;
        root /var/www/certbot;
        add_header Retry-After 60 always;
        add_header Cache-Control "no-store" always;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / { return 404; }
}
