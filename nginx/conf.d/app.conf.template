# Production-конфиг с SSL.
# Активируется deploy.sh после успешного выпуска сертификата.

# HTTP → HTTPS + ACME challenge
server {
    listen 80;
    listen [::]:80;
    server_name ai-cardio.ru www.ai-cardio.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Редирект www → apex
server {
    listen 443 ssl;
    http2 on;
    server_name www.ai-cardio.ru;

    ssl_certificate     /etc/letsencrypt/live/ai-cardio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-cardio.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://ai-cardio.ru$request_uri;
}

# Основной сайт
server {
    listen 443 ssl;
    http2 on;
    server_name ai-cardio.ru;

    ssl_certificate     /etc/letsencrypt/live/ai-cardio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-cardio.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Лимиты на API формы
    client_max_body_size 64k;

    # Логи
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml application/xml+rss
               text/javascript image/svg+xml;
    gzip_min_length 1024;

    # Next.js статика — долгий кеш
    location /_next/static/ {
        proxy_pass http://app:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
