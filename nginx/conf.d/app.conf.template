# Production-конфиг с SSL.
# Активируется deploy.sh после успешного выпуска сертификата.

# HTTP → HTTPS + ACME challenge
server {
    listen 80;
    listen [::]:80;
    server_name ai-cardio.ru www.ai-cardio.ru;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Редирект www → apex
server {
    listen 443 ssl;
    http2 on;
    server_name www.ai-cardio.ru;

    ssl_certificate     /etc/letsencrypt/live/ai-cardio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-cardio.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://ai-cardio.ru$request_uri;
}

# Основной сайт
server {
    listen 443 ssl;
    http2 on;
    server_name ai-cardio.ru;

    ssl_certificate     /etc/letsencrypt/live/ai-cardio.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ai-cardio.ru/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Лимиты на API формы
    client_max_body_size 64k;

    # Логи
    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log;

    # Gzip
    gzip on;
    gzip_types text/plain text/css application/json application/javascript
               application/x-javascript text/xml application/xml application/xml+rss
               text/javascript image/svg+xml;
    gzip_min_length 1024;

    # ---- ДЕМО: web-приложение на вымышленных данных (контейнер cardio-web-demo) ----
    # Образ собран из репозитория web с DEMO_MODE=true: все ответы api — из памяти,
    # сервер, база и ML не нужны. basePath=/web, поэтому /web/* (и /web/api/*) уходит
    # в контейнер как есть. Рабочая система — отдельно, на app.ai-cardio.ru (app.ai-cardio.conf).
    # resolver + переменная => nginx стартует, даже если контейнер демо не запущен;
    # тогда (502/503/504) вместо ошибки отдаём заставку.
    location = /web { return 302 /web/; }
    location /web/ {
        resolver 127.0.0.11 valid=30s;
        set $demo_upstream cardio-web-demo:3000;
        proxy_pass http://$demo_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        # Демо не принимает настоящих снимков: тело запроса до 2 МБ, больше — тот же
        # JSON-ответ 413, что даёт само демо (см. web/src/demo/http.ts, tooLarge).
        client_max_body_size 2m;
        error_page 413 = @demo_too_large;
        proxy_connect_timeout 5s;
        proxy_read_timeout  60s;
        proxy_send_timeout  60s;
        proxy_buffering off;
        # Контейнер демо не запущен (ошибку дал сам nginx) — заставка «демо скоро будет доступно».
        # proxy_intercept_errors не включаем: ответы самого демо (JSON) проходят как есть.
        error_page 502 503 504 =503 /__demo_soon.html;
    }
    location @demo_too_large {
        default_type application/json;
        return 413 '{"error":{"code":"demo_too_large","message":"В демонстрационной версии размер загружаемого файла ограничен 2 МБ. Настоящие снимки сюда загружать не нужно: для примера используется готовое исследование."}}';
    }
    location = /__demo_soon.html {
        internal;
        root /var/www/html;
        add_header Retry-After 20 always;
        add_header Cache-Control "no-store" always;
    }

    # Next.js статика — долгий кеш
    location /_next/static/ {
        proxy_pass http://app:3000;
        proxy_cache_valid 200 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        proxy_pass http://app:3000;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
